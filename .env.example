# HOUME-ADMIN 로컬 개발용 환경변수 예시
# 사용법: 이 파일을 복사해 .env 로 저장하고 값을 채우세요. (.env는 커밋되지 않습니다)
#
# VITE_ 접두사 변수는 빌드 시 클라이언트 번들에 포함됩니다(브라우저 노출).

# API 서버 주소 — HOUME-CLIENT와 같은 값 (로컬은 dev 서버)
VITE_API_BASE_URL=

# 타입 생성용 Swagger 문서 주소 — {VITE_API_BASE_URL}/v3/api-docs
# pnpm api:generate 에서만 쓰이고 번들에는 들어가지 않습니다
SWAGGER_URL=
