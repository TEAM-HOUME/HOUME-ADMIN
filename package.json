{
  "name": "houme-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "knip": "knip",
    "knip:ci": "knip --include dependencies,unlisted,unresolved,binaries",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "api:generate": "node scripts/gen-api.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "axios": "^1.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@antebudimir/eslint-plugin-vanilla-extract": "^1.16.0",
    "@eslint/js": "^9.29.0",
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@types/node": "^24.0.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/vite-plugin": "^5.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "swagger-typescript-api": "^13.6.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
